<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SoundPad.App.Controls.SoundEditorWorkspace" FontFamily="Trebuchet MS, Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Focusable="True" PreviewKeyDown="Window_PreviewKeyDown">
    <UserControl.Resources>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Background" Value="#20263D" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#20263D" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource ComicContours}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="20,14,24,14" Padding="16,10" Background="{StaticResource ComicYellowBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="7" Effect="{StaticResource ComicShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="SOUND EDITOR" FontFamily="Impact" FontSize="27" Foreground="#090D18" />
                    <TextBlock Text="Layer it. Cut it. Make it yours." FontSize="12" Foreground="#171B30" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="690">
                    <ui:TextBox x:Name="MixNameBox" Width="190" PlaceholderText="Untitled Mix" Margin="0,0,8,0" Text="Untitled Mix" />
                    <ui:Button Content="New mix" Background="#FFF6DE" Foreground="#090D18" Click="Cancel_Click" Margin="0,0,6,0" />
                    <ui:Button x:Name="AddSoundButton" Content="Add from library" Background="#FFF6DE" Foreground="#090D18" Click="AddSound_Click" Margin="0,0,6,0" ToolTip="Add a sound from your library" />
                    <ui:Button x:Name="ImportAudioButton" Content="Import audio" Background="#FFF6DE" Foreground="#090D18" Click="ImportAudio_Click" Margin="0,0,6,0" />
                    <ui:Button x:Name="SaveButton" Content="Save to soundboard" Background="{StaticResource ComicCyanBrush}" Foreground="#090D18" ToolTip="Save mix to the active soundboard (Ctrl+S)" Click="Save_Click" Appearance="Primary" Margin="0" />
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="20,0,20,12" Padding="10,8,10,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="7">
            <WrapPanel>
                <ui:Button x:Name="SelectToolButton" Content="Select" Click="SelectTool_Click" Appearance="Primary" Margin="0,0,8,6" ToolTip="Select tool (A)" Padding="10,5" />
                <ui:Button x:Name="CutToolButton" Content="Cut" Click="CutTool_Click" Margin="0,0,8,6" ToolTip="Cut tool (C)" Padding="10,5" />
                <ui:Button x:Name="RippleToolButton" Content="Ripple" Click="RippleTool_Click" Margin="0,0,8,6" ToolTip="Ripple tool (R) — drag moves clip and all clips after it on the same track" Padding="10,5" />
                <ui:Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" IsEnabled="False" Margin="0,0,8,6" ToolTip="Undo (Ctrl+Z)" Padding="10,5" />
                <ui:Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" IsEnabled="False" Margin="0,0,8,6" ToolTip="Redo (Ctrl+Y)" Padding="10,5" />
                <CheckBox x:Name="SnapCheckBox" Content="Snap" VerticalAlignment="Center" Margin="0,0,8,6" ToolTip="Snap clip edges and cuts to playhead and other clip edges" />
                <CheckBox x:Name="TrimHandlesCheckBox" Content="Trim Handles" VerticalAlignment="Center" IsChecked="True" Margin="0,0,8,6" Click="TrimHandlesCheckBox_Click" ToolTip="Enable left/right edge drag handles on clips for trimming" />
                <ui:Button x:Name="DeleteLeftButton" Content="Del Left" Click="DeleteLeft_Click" Margin="0,0,8,6" ToolTip="Delete left of playhead on selected clip" Padding="10,5" />
                <ui:Button x:Name="DeleteRightButton" Content="Del Right" Click="DeleteRight_Click" Margin="0,0,8,6" ToolTip="Delete right of playhead on selected clip" Padding="10,5" />
                <ui:Button Content="Split" Click="Split_Click" Padding="10,5" Margin="0,0,6,6" />
                <ui:Button Content="Copy" Click="Copy_Click" Padding="10,5" Margin="0,0,6,6" />
                <ui:Button Content="Paste" Click="Paste_Click" Padding="10,5" Margin="0,0,6,6" />
                <ui:Button Content="Duplicate" Click="Duplicate_Click" Padding="10,5" Margin="0,0,6,6" />
                <ui:Button Content="Remove clip" Click="RemoveClip_Click" Padding="10,5" Margin="0,0,6,6" />
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Margin="20,0,20,12" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="7" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175" MinWidth="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="215" MinWidth="160" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource ComicInkBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <ScrollViewer x:Name="LabelScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TrackLabelPanel" />
                        </ScrollViewer>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="TimelineScrollViewer_ScrollChanged" PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="RulerCanvas" Grid.Row="0" Height="26" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" MouseLeftButtonDown="Ruler_MouseLeftButtonDown" MouseMove="Ruler_MouseMove" MouseLeftButtonUp="Ruler_MouseLeftButtonUp" />
                        <Canvas x:Name="TimelineCanvas" Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}" MouseLeftButtonDown="Timeline_MouseLeftButtonDown" MouseMove="Timeline_MouseMove" MouseLeftButtonUp="Timeline_MouseLeftButtonUp" MouseLeave="Timeline_MouseLeave" MouseRightButtonUp="Timeline_MouseRightButtonUp" />
                    </Grid>
                </ScrollViewer>
                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource ComicInkBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,10,12,10">
                            <TextBlock Text="CLIP SETTINGS" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,10" FontFamily="Impact" Foreground="{StaticResource ComicCyanBrush}" />
                            <TextBlock x:Name="ClipInfoPlaceholder" Text="Select a clip to adjust volume and fades." Opacity="1" HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="ClipInfoContent" Visibility="Collapsed">
                                <TextBlock Text="Source" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock x:Name="PanelSourceLabel" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Track" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                        <TextBlock x:Name="PanelTrackLabel" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Start" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                        <TextBlock x:Name="PanelStartLabel" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Duration" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock x:Name="PanelDurationLabel" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource ComicInkBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="Volume" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PanelVolumeSlider" Grid.Column="0" Minimum="0" Maximum="200" LargeChange="10" SmallChange="1" VerticalAlignment="Center" ValueChanged="PanelVolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="PanelVolumeLabel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
                                </Grid>
                                <TextBlock Text="Fade In (s)" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="PanelFadeInBox" Margin="0,0,0,8" />
                                <TextBlock Text="Fade Out (s)" Opacity="0.55" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="PanelFadeOutBox" Margin="0,0,0,14" />
                                <ui:Button x:Name="PanelApplyButton" Content="Apply" Appearance="Primary" HorizontalAlignment="Stretch" Click="PanelApply_Click" Margin="0,0,0,6" />
                                <ui:Button x:Name="PanelAudioSettingsButton" Content="Audio Settings…" HorizontalAlignment="Stretch" Click="PanelAudioSettings_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="EditorEmptyText" Grid.Column="1" Text="DROP YOUR FIRST SOUND&#10;Add from library or import an audio file to start mixing." FontSize="16" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="20,0,20,10" Padding="12,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="7">
            <DockPanel LastChildFill="True">
                <ui:Button x:Name="ExportWavButton" DockPanel.Dock="Right" Content="Export WAV" Click="ExportWav_Click" Margin="12,0,0,0" />
                <WrapPanel VerticalAlignment="Center">
                    <ui:Button x:Name="PreviewButton" Content="▶ Preview" Click="Preview_Click" Margin="0,0,6,0" ToolTip="Preview from playhead (Space)" />
                    <ui:Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click" IsEnabled="False" Margin="0,0,6,0" ToolTip="Stop preview (Space)" />
                    <TextBlock x:Name="TransportTimeText" Text="00:00.0 / 00:00.0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ComicCyanBrush}" Margin="12,0,20,0" VerticalAlignment="Center" />
                    <ui:Button Content="-" Click="ZoomOut_Click" Width="36" Margin="0,0,5,0" ToolTip="Zoom Out" />
                    <ui:Button Content="+" Click="ZoomIn_Click" Width="36" Margin="0,0,5,0" ToolTip="Zoom In" />
                    <ui:Button Content="Fit" Click="ZoomFit_Click" Width="44" Margin="0,0,5,0" ToolTip="Zoom to Fit timeline" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="4" Padding="22,0,22,10">
            <TextBlock x:Name="StatusText" Text="Ready — Select tool active" Opacity="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </Border>
        <Grid x:Name="SoundPickerOverlay" Grid.Row="2" Visibility="Collapsed" Panel.ZIndex="50" Background="#A0000000">
            <Border Width="580" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ADD A SOUND" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" FontFamily="Impact" Foreground="{StaticResource ComicYellowBrush}" />
                    <ui:TextBox x:Name="PickerSearchBox" Grid.Row="1" PlaceholderText="Search sounds..." TextChanged="PickerSearch_TextChanged" />
                    <ListBox x:Name="SoundPickerList" Grid.Row="2" MinHeight="160" MaxHeight="280" Margin="0,8,0,0" SelectionMode="Single" MouseDoubleClick="PickerAddNewTrack_Click" />
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Cancel" Click="PickerCancel_Click" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="PickerAddToTrackButton" Content="Add to Selected Track" Click="PickerAddToTrack_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="Add clip to selected track at current playhead" />
                            <ui:Button Content="Add as New Track" Click="PickerAddNewTrack_Click" Appearance="Primary" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>