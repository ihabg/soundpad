<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SoundPad.App.Dialogs.CategoryManagerDialog" Title="Manage Categories" Width="560" Height="700" MinWidth="560" MinHeight="700" MaxWidth="560" MaxHeight="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Trebuchet MS, Segoe UI" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Background" Value="#20263D" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#323A58" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{StaticResource ComicContours}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Manage Categories" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Tag20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Border Grid.Row="1" Margin="20,6,24,16" Padding="16,12" Background="{StaticResource ComicYellowBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="7" Effect="{StaticResource ComicShadow}">
            <StackPanel>
                <TextBlock x:Name="HeroTitleText" Text="SORT YOUR SOUNDS" FontFamily="Impact" FontSize="28" Foreground="#090D18" />
                <TextBlock Text="Create, rename, and organize your categories." FontSize="12" Foreground="#171B30" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Margin="20,0,20,16" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="8">
                <StackPanel Margin="0">
                    <TextBlock Text="YOUR CATEGORIES" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ComicCyanBrush}" Margin="0,0,0,8" FontFamily="Impact" />
                    <ListBox x:Name="CategoryListBox" Height="195" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="3,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CategoryRow" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CategoryRow" Property="Background" Value="#323A58" />
                                                    <Setter TargetName="CategoryRow" Property="BorderBrush" Value="#090D18" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CategoryRow" Property="Background" Value="#323A58" />
                                                    <Setter TargetName="CategoryRow" Property="BorderBrush" Value="#69E4DE" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="CreateButton" Content="Create" Appearance="Secondary" Click="Create_Click" Background="{StaticResource ComicCyanBrush}" Foreground="Black">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="RenameButton" Content="Rename" Appearance="Secondary" IsEnabled="False" Margin="8,0,0,0" Click="Rename_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Edit20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="DeleteButton" Content="Delete" Appearance="Danger" IsEnabled="False" Margin="8,0,0,0" Click="Delete_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete20" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    <Border x:Name="EditZone" Visibility="Collapsed" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" CornerRadius="6" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="EditZoneLabel" Text="New category name:" FontSize="12" Foreground="{StaticResource ComicCyanBrush}" Margin="0,0,0,6" FontWeight="Bold" />
                            <ui:TextBox x:Name="EditBox" Visibility="Visible" Margin="0,0,0,10" KeyDown="EditBox_KeyDown" />
                            <TextBlock x:Name="MoveToLabel" Text="Move sounds to:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="0,0,0,6" />
                            <ComboBox x:Name="MoveToCombo" Visibility="Collapsed" Margin="0,0,0,10" />
                            <TextBlock x:Name="EditErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Cancel" Appearance="Secondary" Width="80" Click="EditCancel_Click" />
                                <ui:Button Content="Confirm" Appearance="Primary" Width="90" Margin="8,0,0,0" Click="EditConfirm_Click" Background="{StaticResource ComicCyanBrush}" Foreground="Black" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="0,3,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Done" Appearance="Primary" Width="100" Click="Done_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>