<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SoundPad.App.Dialogs.ColorPickerDialog" Title="Sound Color" Width="540" Height="800" MinWidth="540" MinHeight="640" MaxWidth="540" MaxHeight="900" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Trebuchet MS, Segoe UI" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" PreviewKeyDown="Window_PreviewKeyDown" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Background" Value="#20263D" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CaretBrush" Value="{StaticResource ComicCyanBrush}" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{StaticResource ComicContours}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Sound Color" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Color20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Border Grid.Row="1" Background="{StaticResource ComicYellowBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="7" Margin="20,6,24,16" Padding="16,12" Effect="{StaticResource ComicShadow}">
            <StackPanel>
                <TextBlock Text="MAKE IT POP!" FontFamily="Impact" FontSize="30" Foreground="#090D18" />
                <TextBlock Text="Pick a preset or mix your own color." FontSize="12" Foreground="#171B30" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,6">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PRESET COLORS" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ComicCyanBrush}" Margin="0,0,0,10" FontFamily="Impact" />
                        <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,4" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CUSTOM COLOR" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ComicCyanBrush}" Margin="0,0,0,10" FontFamily="Impact" />
                        <TextBlock Text="HEX" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" />
                        <ui:TextBox x:Name="HexBox" PlaceholderText="#RRGGBB" MaxLength="7" Margin="0,0,0,14" TextChanged="HexBox_TextChanged" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="R" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center" Margin="6,0,8,0" ValueChanged="RgbSlider_ValueChanged" />
                            <ui:TextBox x:Name="RedBox" Grid.Column="2" MaxLength="3" TextAlignment="Right" TextChanged="RgbBox_TextChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="G" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center" Margin="6,0,8,0" ValueChanged="RgbSlider_ValueChanged" />
                            <ui:TextBox x:Name="GreenBox" Grid.Column="2" MaxLength="3" TextAlignment="Right" TextChanged="RgbBox_TextChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="B" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center" Margin="6,0,8,0" ValueChanged="RgbSlider_ValueChanged" />
                            <ui:TextBox x:Name="BlueBox" Grid.Column="2" MaxLength="3" TextAlignment="Right" TextChanged="RgbBox_TextChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ComicCyanBrush}" Margin="0,0,0,10" FontFamily="Impact" />
                        <Border x:Name="PreviewSwatch" Height="56" CornerRadius="6" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" Margin="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="0,3,0,0">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <ui:Button Content="Cancel" Appearance="Secondary" Width="100" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
                    <ui:Button x:Name="ApplyButton" Content="Apply color" Appearance="Primary" Width="130" Click="Apply_Click" Background="{StaticResource ComicCyanBrush}" Foreground="#090D18" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>