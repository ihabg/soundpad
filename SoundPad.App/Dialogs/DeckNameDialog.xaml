<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SoundPad.App.Dialogs.DeckNameDialog" Title="Deck Name" Width="500" Height="340" MinWidth="500" MinHeight="340" MaxWidth="500" MaxHeight="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Trebuchet MS, Segoe UI" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Background" Value="#20263D" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#323A58" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComicInkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{StaticResource ComicContours}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" Title="Deck Name" ShowMinimize="False" ShowMaximize="False" />
        <Border Grid.Row="1" Margin="20,6,24,16" Padding="16,12" Background="{StaticResource ComicYellowBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="3" CornerRadius="7" Effect="{StaticResource ComicShadow}">
            <StackPanel>
                <TextBlock x:Name="HeroTitleText" Text="NEW DECK" FontFamily="Impact" FontSize="28" Foreground="#090D18" />
                <TextBlock Text="Give your next sound collection a home." FontSize="12" Foreground="#171B30" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="20,0,20,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="2" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock x:Name="InstructionText" Text="Enter a name for this deck:" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
                <ui:TextBox x:Name="NameBox" PlaceholderText="e.g. Gaming, Work, Podcast…" MaxLength="60" Margin="0,0,0,8" KeyDown="NameBox_KeyDown" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Visibility="Collapsed" Margin="0,0,0,12" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ComicInkBrush}" BorderThickness="0,3,0,0">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1" Content="Cancel" Appearance="Secondary" Width="90" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
                <ui:Button x:Name="OkButton" Grid.Column="2" Content="Create deck" Appearance="Primary" Width="130" Click="Ok_Click" Background="{StaticResource ComicCyanBrush}" Foreground="Black" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>